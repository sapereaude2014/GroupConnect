# ==============================================================================
# GroupConnect Environment Variables
# ==============================================================================
# Copy this file to ~/.config/groupconnect/.env (or any *.env in that directory)
# and fill in your values. The loader auto-discovers .env and *.env files.
# All values support ${VAR} and ${VAR:-default} interpolation in groupconnect.yaml.
# ==============================================================================

# ---- Bot Token (required) ----
# Matches ${CODER_BOT_TOKEN} in groupconnect.example.yaml
CODER_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTuvWxyz

# ---- Classifier API Key (one required, depends on classifier engine) ----
# Jev is the default classifier (100-200ms). Just set this key and you're done.
JEV_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Alternative classifiers (uncomment if you use a different engine):
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional Extensions ----
# AMAP_WEB_KEY=                 # Geocoding (high-altitude map lookup)
# TELEGRAPH_ACCESS_TOKEN=       # Telegraph page publishing for long replies
